    {
      "name": "tableFiltered",
      "source": "table",
      "transform": [
        {
          "type": "stack",
          "groupby": [
            "year"
          ],
          "sort": {
            "field": "source"
          },
          "field": "value",
          "as": [
            "y0",
            "y1"
          ]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x_year",
      "type": "linear",
      "domain": [
        2014,
        2024
      ],
      "range": [
        0,
        600
      ],
      "zero": false,
      "nice": false
    },
    {
      "name": "y_value",
      "type": "linear",
      "domain": [
        0,
        1400
      ],
      "range": [
        400,
        0
      ],
      "zero": true,
      "nice": false
    },
    {
      "name": "color",
      "type": "ordinal",
      "domain": [
        "Bioenergy",
        "Coal",
        "Gas",
        "Hydro",
        "Nuclear",
        "Oil",
        "Other renewables",
        "Solar",
        "Wind"
      ],
      "range": [
        "#4c78a8",
        "#f58518",
        "#e45756",
        "#72b7b2",
        "#54a24b",
        "#eeca3b",
        "#b279a2",
        "#ff9da6",
        "#9d755d"
      ]
    }
  ],
  "axes": [
    {
      "orient": "bottom",
      "scale": "x_year",
      "format": "d",
      "title": "Year",
      "grid": false,
      "domain": true,
      "tickCount": 8
    },
    {
      "orient": "left",
      "scale": "y_value",
      "title": "Electricity generation (TWh)",
      "grid": true,
      "gridColor": "#e3e3e3",
      "domain": true
    }
  ],
  "marks": [
    {
      "type": "group",
      "from": {
        "facet": {
          "name": "series",
          "data": "tableFiltered",
          "groupby": "source"
        }
      },
      "marks": [
        {
          "type": "area",
          "from": {
            "data": "series"
          },
          "encode": {
            "enter": {
              "x": {
                "scale": "x_year",
                "field": "year"
              },
              "y": {
                "scale": "y_value",
                "field": "y0"
              },
              "y2": {
                "scale": "y_value",
                "field": "y1"
              },
              "fill": {
                "scale": "color",
                "field": "source"
              },
              "tooltip": {
                "signal": "{'Source': datum.source, 'Year': datum.year, 'TWh': format(datum.value, ',.1f')}"
              }
            }
          }
        }
      ]
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "value": 615
          },
          "y": {
            "value": -10
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": "bold"
          },
          "text": {
            "value": "Source"
          }
        }
      }
    },
    {
      "type": "symbol",
      "name": "legendSwatch",
      "from": {
        "data": "sourcesLegend"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 620
          },
          "y": {
            "signal": "10 + datum.i * 20"
          },
          "shape": {
            "value": "circle"
          },
          "size": {
            "value": 90
          },
          "fill": {
            "field": "color"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "sourcesLegend"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 630
          },
          "y": {
            "signal": "10 + datum.i * 20"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "value": 11
          },
          "text": {
            "field": "source"
          }
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "signals": [
      {
        "name": "tooltip",
        "value": null,
        "on": [
          {
            "events": {
              "type": "pointerover",
              "marktype": "area",
              "debounce": 500
            },
            "update": "tooltip && tooltip.Source === datum.source && tooltip.Year === round(invert('x_year', x())) ? tooltip : {'Source': datum.source, 'Year': round(invert('x_year', x()))}"
          }
        ]
      },
      {
        "name": "revisitAnswer",
        "value": {},
        "on": [
          {
            "events": {
              "signal": "tooltip"
            },
            "update": "{responseId: 'stackedarea-value-hover', response: 'interacted'}"
          }
        ]
      }
    ]
  },
  "signals": [
    {
      "name": "hover",
      "value": null,
      "on": [
        {
          "events": "area:pointerover",
          "update": "datum.source"
        },
        {
          "events": "area:pointerout",
          "update": "null"
        }
      ]
    }
  ]
}
