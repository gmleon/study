{
    "$schema": "https://raw.githubusercontent.com/revisit-studies/study/main/src/parser/StudyConfigSchema.json",
    "studyMetadata": {
        "title": "Interactive Data Visualizations",
        "version": "1.1.0",
        "authors": [
            "The Interactive Visualization Literacy Team"
        ],
        "date": "2026-08-27",
        "description": "A study on the ability to use interactive data visualizations",
        "organizations": [
            "Aarhus University",
            "Inria Bordeaux",
            "University of Bremen",
            "TU Dresden"
        ]
    },
    "uiConfig": {
        "contactEmail": "leon@cs.au.dk",
        "helpTextPath": "basic-questionnaire-study/assets/help.md",
        "logoPath": "revisitAssets/revisitLogoSquare.svg",
        "withProgressBar": true,
        "autoDownloadStudy": false,
        "withSidebar": true
    },
    "studyRules": {
        "display": {
        "minHeight": 400,
        "minWidth": 800
        },
        "browsers": {
        "allowed": [
            {
            "name": "chrome",
            "minVersion": 100
            },
            {
            "name": "firefox",
            "minVersion": 100
            },
            {
            "name": "safari",
            "minVersion": 10
            }
        ],
        "blockedMessage": "You must be on a relatively modern browser, Chrome > 100, Firefox > 100, Safari > 10."
        },
        "devices": {
        "allowed": ["desktop"]
        },
        "inputs": {
        "allowed": ["mouse"]
        }
    },
    "components": {
        "introduction": {
            "type": "markdown",
            "path": "basic-questionnaire-study/assets/introduction.md",
            "response": []
        },
        "consent": {
            "type": "markdown",
            "path": "basic-questionnaire-study/assets/consent.md",
            "nextButtonText": "I agree",
            "response": []
        },
        "transition": {
            "type": "markdown",
            "path": "basic-questionnaire-study/assets/transition.md",
            "nextButtonText": "Start the mini-VLAT test",
            "response": []
        },
        "line-value": {
            "instruction": "What was the tuberculosis case detection rate in South Asia in 2018?",
            "instructionLocation": "sidebar",
            "type": "vega",
            "path": "basic-questionnaire-study/assets/tuberculosisDetectionExplorer.json",
            "enumerateQuestions": true,
            "response": [
            {
                "id": "res-line-value",
                "type": "radio",
                "prompt": "Your answer",
                "required": true,
                "location": "sidebar",
                "options": ["55%", "63%", "74%", "78%", "Skip"]
            }
            ],
            "correctAnswer": [
                {
                "id": "res-line-value",
                "answer": "63%"
                }
            ]
        },
        "line-trend": {
            "instruction": "What was the trend of the stock prices from May to July?",
            "instructionLocation": "sidebar",
            "type": "vega",
            "path": "basic-questionnaire-study/assets/linkedLinesExplorer.json",
            "enumerateQuestions": true,
            "response": [
            {
                "id": "res-line-trend",
                "type": "radio",
                "prompt": "Your answer",
                "required": true,
                "location": "sidebar",
                "options": [
                    "The stock prices were rising",
                    "The stock prices were falling",
                    "One stock was rising, while the other one was falling",
                    "One stock was rising, while the other one was constant",
                    "Skip"
                ]
            }
            ],
            "correctAnswer": [
                {
                "id": "res-line-trend",
                "answer": "One stock was rising, while the other one was constant"
                }
            ]
        },
        "line-comparison": {
            "description": "Interacting with a line chart",
            "instruction": "What was the ratio of goats slaughtered in Pakistan to those slaughtered in China in 2005?",
            "instructionLocation": "sidebar",
            "type": "website",
            "path": "basic-questionnaire-study/assets/animalWelfareExplorer.html",
            "style": { "minHeight": "500px" },
            "enumerateQuestions": true,
            "response": [
            {
                "id": "res-line-comparison",
                "type": "radio",
                "prompt": "Your answer",
                "required": true,
                "location": "sidebar",
                "options": ["1 to 2", "1 to 4", "1 to 6", "1 to 8", "Skip"]
            }
            ],
            "correctAnswer": [
                {
                "id": "res-line-comparison",
                "answer": "1 to 6"
                }
            ]     
        },
