    "importedLibraries": ["mini-vlat"],
    "sequence": {
        "order": "fixed",
        "components": [
            "introduction",
            "consent",
            {
                "id": "attention-block",
                "order": "fixed",
                "components": ["bar-extremum", "attention-check-1"],
                "skip": [
                    {
                        "name": "attention-check-1",
                        "check": "response",
                        "responseId": "res-attention-check-1",
                        "comparison": "notEqual",
                        "value": "Skip",
                        "to": "attention-branch-fail"
                    }
                ]
            },
            {
                "id": "attention-branch-pass",
                "order": "fixed",
                "components": ["line-trend", "stackedbar-value", "attention-check-2"],
                "skip": [
                    {
                        "name": "attention-check-2",
                        "check": "response",
                        "responseId": "res-attention-check-2",
                        "comparison": "notEqual",
                        "value": "__always-true__",
                        "to": "scatterplot-comparison"
                    }
                ]
            },
            {
                "id": "attention-branch-fail",
                "order": "fixed",
                "components": ["line-trend", "stackedbar-value", "attention-check-2"],
                "skip": [
                    {
                        "name": "attention-check-2",
                        "check": "response",
                        "responseId": "res-attention-check-2",
                        "comparison": "notEqual",
                        "value": "Skip",
                        "to": "attention-fail"
                    }
                ]
            },
            "scatterplot-comparison",
            "stackedarea-value",
            "bar-comparison",
            "line-value",
            "stackedbar-comparison",
            "scatterplot-trend",
            "stackedarea-comparison",
            "bar-value",
            "line-extremum",
            "area-value",
            "scatterplot-extremum",
            "stackedarea-trend",
            "line-comparison",
            "scatterplot-trend-2",
            "stackedarea-extremum",
            "transition",
            "$mini-vlat.sequences.full",
            {
                "id": "demographics-block",
                "order": "fixed",
                "components": ["demographics"],
                "skip": [
                    {
                        "check": "block",
                        "condition": "numCorrect",
                        "value": 1,
                        "to": "end"
                    }
                ]
            },
            "attention-fail"
        ]
    }
}