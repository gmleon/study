        "attention-check-1": {
            "description": "Instructional manipulation check 1 (Prolific policy): explicit instruction in the question itself, participant told it is an attention check, single unambiguous correct answer ('Skip'), no memory recall, no timing. Presented like a puzzle (static chart + sidebar question).",
            "instruction": "This chart is not interactive because this is an attention check. Regardless of what the chart shows, please select 'Skip' as your answer.",
            "instructionLocation": "sidebar",
            "type": "vega",
            "path": "basic-questionnaire-study/assets/attentionCheckRainfall.json",
            "enumerateQuestions": true,
            "response": [
            {
                "id": "res-attention-check-1",
                "type": "radio",
                "prompt": "Your answer",
                "required": true,
                "location": "sidebar",
                "options": ["Lisbon", "Oslo", "Prague", "Dublin", "Skip"]
            }
            ],
            "correctAnswer": [
                {
                "id": "res-attention-check-1",
                "answer": "Skip"
                }
            ]
        },
        "attention-check-2": {
            "description": "Instructional manipulation check 2 (Prolific policy), same design as attention-check-1 with a different chart. Appears in both branches after check 1; in the branch for participants who failed check 1, failing this one too sends them to attention-fail.",
            "instruction": "Regardless of what the chart shows, please select 'Skip' as your answer. This is an attention check.",
            "instructionLocation": "sidebar",
            "type": "vega",
            "path": "basic-questionnaire-study/assets/attentionCheckLibraries.json",
            "enumerateQuestions": true,
            "response": [
            {
