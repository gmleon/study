                }
            ]
        },
        "attention-fail": {
            "description": "Screen-out page for participants who failed both attention checks. Reached only via the skip condition in the attention-branch-fail block; the demographics block always skips to 'end', so regular participants never see it. Its stylesheet hides the Next button so the study end screen (with the Prolific completion link) cannot be reached from here.",
            "type": "markdown",
            "path": "basic-questionnaire-study/assets/attentionFail.md",
            "stylesheetPath": "basic-questionnaire-study/assets/attentionFail.css",
            "response": []
        }
