        "demographics": {
            "type": "questionnaire",
            "response": [
                {
                    "id": "q1-gender",
                    "prompt": "Which gender do you identify with?",
                    "required": true,
                    "location": "aboveStimulus",
                    "type": "radio",
                    "withOther": true,
                    "options": [
                        "Woman / Female (Cis or Trans)",
                        "Man / Male (Cis or Trans)",
                        "Non-binary",
                        "Prefer not to answer"
                    ]
                },
                {
                    "id": "q2-age",
                    "prompt": "What is your age group?",
                    "required": true,
                    "location": "aboveStimulus",
                    "type": "radio",
                    "options": [
                        "Under 18 years",
                        "18-24 years",
                        "25-34 years",
                        "35-44 years",
                        "45-54 years",
                        "55-64 years",
                        "65 years or older"
                    ]
                },
                {
                    "id": "q3-degree",
                    "prompt": "What is the highest degree or level of education you have completed?",
                    "required": true,
                    "location": "aboveStimulus",
                    "type": "radio",
                    "withOther": true,
                    "options": [
                        "None",
                        "High school diploma or equivalent",
                        "Bachelor's degree or equivalent",
                        "Master's degree or equivalent",
                        "Doctoral degree or equivalent"
                    ]
                },
                {
                    "id": "q5-vision",
                    "prompt": "Do you have color vision deficiency?",
                    "infoText": "Having color vision deficiency means you cannot see certain colors the way most people do — or you may not see color at all.",
                    "required": true,
                    "location": "aboveStimulus",
                    "type": "radio",
                    "options": [
                        "Yes",
                        "No"
                    ]
                },
                {
                    "id": "q4-comment",
                    "prompt": "Please share any comments or suggestions you would like to share:",
                    "required": false,
                    "location": "aboveStimulus",
                    "type": "longText",
                    "placeholder": "Please enter your comments or suggestions"
                }
            ],
            "instruction": "# Demographics \n You have now completed the Mini-VLAT test. Please share with us a few details about yourself below.",
            "instructionLocation": "aboveStimulus"
        }
    },
