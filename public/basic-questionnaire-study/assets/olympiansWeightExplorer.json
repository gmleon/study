      "domain": true
    },
    {
      "orient": "left",
      "scale": "y_count",
      "title": "Count",
      "grid": true,
      "gridColor": "#e3e3e3",
      "domain": true
    }
  ],
  "marks": [
    {
      "type": "rect",
      "name": "bars",
      "from": {
        "data": "binsFiltered"
      },
      "encode": {
        "enter": {
          "fill": {
            "scale": "color",
            "field": "sex"
          },
          "tooltip": {
            "signal": "{'Weight (kg)': datum.bin_start + '-' + datum.bin_end, 'Sex': datum.sex, 'Count': datum.count}"
          }
        },
        "update": {
          "x": {
            "scale": "x_weight",
            "field": "bin_start"
          },
          "x2": {
            "scale": "x_weight",
            "field": "bin_end"
          },
          "y": {
            "scale": "y_count",
            "signal": "highlight ? 0 : datum.y0_all"
          },
          "y2": {
            "scale": "y_count",
            "signal": "highlight ? datum.count : datum.y1_all"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "value": 622
          },
          "y": {
            "value": -10
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": "bold"
          },
          "text": {
            "value": "Sex"
          }
        }
      }
    },
    {
      "type": "symbol",
      "name": "legendSwatch",
      "from": {
        "data": "sexLegend"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 610
          },
          "y": {
            "signal": "10 + datum.i * 20"
          },
          "shape": {
            "value": "square"
          },
          "size": {
            "value": 90
          },
          "fill": {
            "field": "color"
          },
          "cursor": {
            "value": "pointer"
          }
        },
        "update": {
          "opacity": {
            "signal": "!highlight || highlight === datum.sex ? 1 : 0.3"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "sexLegend"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 620
          },
          "y": {
            "signal": "10 + datum.i * 20"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "value": 11
          },
          "text": {
            "field": "sex"
          }
        },
        "update": {
          "opacity": {
            "signal": "!highlight || highlight === datum.sex ? 1 : 0.3"
          }
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "signals": [
      {
        "name": "highlight",
        "value": null,
        "on": [
          {
            "events": "@legendSwatch:mousedown",
            "update": "datum.sex === highlight ? null : datum.sex"
          },
          {
            "events": "dblclick",
            "update": "null"
          }
        ]
      },
      {
        "name": "tooltip",
        "value": null,
        "on": [
          {
            "events": {
              "type": "pointerover",
              "markname": "bars",
              "debounce": 500
            },
            "update": "tooltip && tooltip.bin === datum.bin_start && tooltip.Sex === datum.sex ? tooltip : {'bin': datum.bin_start, 'Weight (kg)': datum.bin_start + '-' + datum.bin_end, 'Sex': datum.sex, 'Count': datum.count}"
          }
        ]
      },
      {
        "name": "revisitAnswer",
        "value": {},
        "on": [
          {
            "events": {
              "signal": "highlight"
            },
            "update": "{responseId: 'stackedbar-value-hover', response: 'interacted'}"
          },
          {
            "events": {
              "signal": "tooltip"
            },
            "update": "{responseId: 'stackedbar-value-hover', response: 'interacted'}"
          }
        ]
      }
    ]
  }
