      "source": "bins",
      "transform": [
        {
          "type": "filter",
          "expr": "!highlight || datum.sex === highlight"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x_weight",
      "type": "linear",
      "domain": [
        30,
        172
      ],
      "range": [
        0,
        600
      ],
      "zero": false,
      "nice": false
    },
    {
      "name": "y_count",
      "type": "linear",
      "domain": [
        0,
        650
      ],
      "range": [
        400,
        0
      ],
      "zero": true,
      "nice": false
    },
    {
      "name": "color",
      "type": "ordinal",
      "domain": [
        "female",
        "male"
      ],
      "range": [
        "#4c78a8",
        "#f58518"
      ]
    }
  ],
  "axes": [
    {
      "orient": "bottom",
      "scale": "x_weight",
      "title": "Weight (kg)",
